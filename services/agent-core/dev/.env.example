# 复制为 .env.local 并填入密钥：cp dev/.env.example dev/.env.local
DEEPSEEK_API_KEY=your-deepseek-api-key

# 对话 MCP（与 platform-api ops_dialogue_mcp / es_log_mcp、仓库根 .env 一致）
AIW_OPS_MCP_INTERNAL_SECRET=dev-ops-mcp-internal-secret
AIW_OPS_MCP_ACTOR_SECRET=dev-ops-mcp-actor-secret
AIW_ES_LOG_MCP_INTERNAL_SECRET=dev-es-log-internal-secret
AIW_ES_LOG_MCP_ACTOR_SECRET=dev-es-log-actor-secret
AIW_ES_LOG_MCP_CURSOR_SECRET=dev-es-log-cursor-secret
AIW_ES_LOG_MCP_ENABLED=true

# 数据库驱动：sqlite（默认）| postgres
# GO_AGENT_DATABASE_DRIVER=postgres
# GO_AGENT_POSTGRES_DSN=postgres://aiw:aiw@127.0.0.1:5432/aiw?sslmode=disable
