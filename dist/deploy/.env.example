# 复制为 deploy/.env（勿提交密钥）
# 也可: python scripts/xhs-docker.py sync-env  # 从 data/xhs/settings/llm.settings.json 同步

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AGENTX_MODEL=deepseek-chat

# Codex（容器内 /usr/local/bin/codex）
AIW_CODEX_ENABLED=true
AIW_CODEX_DEFAULT_ENGINE=codex
# AIW_CODEX_BINARY_SHA256=abf1bb1643a79f73aa78ee627e111e02d4f8c98f25813a0cf6ce277709664386

# 可选联网
# TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5

# 容器内默认跳过 Playwright 热点采集；宿主采集可关此项
XHS_SKIP_STARTUP_COLLECT=1

# 工作台登录（首次启动且尚无 data/xhs/auth.json 时生效；已有 auth.json 不会被覆盖）
XHS_AUTH_USER=admin
XHS_AUTH_PASSWORD=

# Docker 宿主机映射（与 AI-workspace 的 8081 错开）
XHS_AGENT_CORE_HOST_PORT=8082

# 公网部署（腾讯云等）：浏览器 Origin，供 agent-core CORS
# XHS_CORS_ORIGINS=http://你的公网IP或域名,http://127.0.0.1:8097